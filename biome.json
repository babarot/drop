{
  "files": {
    "includes": [
      "**",
      "!app/dist",
      "!dist",
      "!node_modules",
      "!.wrangler",
      "!worker-configuration.d.ts",
      "!tmp-*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
